# ========================================================
# CinemaHub - Environment Configuration Example
# ========================================================

# App Settings
PORT=3000
NODE_ENV=development
API_PREFIX=api

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/cinemahub?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=cinemahub
POSTGRES_PORT=5432

# In-Memory Cache & Distributed Lock (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# Security & Authentication (JWT)
JWT_SECRET=cinemahub_super_secret_jwt_access_token_key_2026_min_32_chars!
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=cinemahub_super_secret_jwt_refresh_token_key_2026_secure!
JWT_REFRESH_EXPIRES_IN=7d

# Personal Identifiable Information (PII) Protection (PDPD Nghị định 13/2023/NĐ-CP)
# 32-byte hexadecimal key for AES-256-GCM
PII_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Salt for Blind Index HMAC-SHA256
PII_BLIND_INDEX_SALT=cinemahub_pii_blind_index_salt_secure_2026

# Google OAuth 2.0 (Optional for local testing)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Mail Service (Nodemailer - SMTP Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CinemaHub Support <no-reply@cinemahub.vn>"

# Telegram Security Alerts (Brute-force / Critical Events)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# VNPay Payment Gateway (Sandbox)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/booking/vnpay-return

# AI Chatbot Concierge (Google Gemini)
GEMINI_API_KEY=

# Frontend Configuration
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000

